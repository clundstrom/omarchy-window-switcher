#!/bin/bash
set -euo pipefail
ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
"$ROOT/bin/cargo-tool" build --manifest-path "$ROOT/rust/Cargo.toml" --release --locked
BUILD_DIR=$("$ROOT/bin/cargo-tool" --build-path)
mkdir -p "$BUILD_DIR/qt-plugin"
cd "$BUILD_DIR/qt-plugin"
qmake6 "$ROOT/native/core.pro" "RUST_TARGET_DIR=$BUILD_DIR"
make -j"${BUILD_JOBS:-2}"
python - "$ROOT" <<'PYMODULE'
from pathlib import Path
import sys
root = Path(sys.argv[1])
# Quickshell embeds relative QML imports as resources. Native libraries need
# a filesystem location, generated for this checkout rather than a global path.
template = (root / 'native/WorkspaceSwitcherCore/qmldir.in').read_text()
(root / 'native/WorkspaceSwitcherCore/qmldir').write_text(template.replace('@PLUGIN_DIRECTORY@', str(root / 'native')))
PYMODULE
